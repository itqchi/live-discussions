# Required: LiveKit server connection
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Persistence mode. Keep memory for local development.
DATABASE_DRIVER=memory

# PostgreSQL is only used when DATABASE_DRIVER=postgres.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_discussions

# Optional infrastructure for a later implementation slice.
# REDIS_URL=redis://localhost:6379
